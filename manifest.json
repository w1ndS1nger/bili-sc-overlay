{
  "manifest_version": 3,
  "name": "B站直播醒目留言叠加层",
  "version": "1.3.0",
  "description": "在B站直播全屏及站内悬浮播放器显示可拖动、可调整大小的醒目留言。",
  "permissions": ["storage"],
  "action": { "default_title": "醒目留言显示设置", "default_popup": "popup.html" },
  "host_permissions": ["https://api.live.bilibili.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://live.bilibili.com/*"],
    "js": ["sc-data.js", "content.js"],
    "run_at": "document_idle"
  }]
}
